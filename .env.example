# Copy to .env.local and fill in from your Supabase project settings.
# Never commit real credentials. The demo UI does not require any of these values.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# AI (server-only; leave blank for demo canned replies)
AI_PROVIDER=open-notebook
OPEN_NOTEBOOK_URL=http://192.168.1.191:8502
OPEN_NOTEBOOK_API_URL=http://192.168.1.191:5055
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
